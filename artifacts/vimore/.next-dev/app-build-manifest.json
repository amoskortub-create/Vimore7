    ],
    "/settings/account/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/settings/account/page.js"
    ],
    "/settings/language/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/settings/language/page.js"
    ],
    "/messages/loading": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/messages/loading.js"
    ],
    "/messages/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
